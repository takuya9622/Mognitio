(in-package #:mognitio.machine)

(defstruct instruction opcode operands span)
(defun lower-module (module)
  (mognitio.ir:verify-module module)
  (unless (= 1 (length (mognitio.ir:module-functions module)))
    (internal-error "Machine lowering currently requires the synthetic entry"))
  (let ((function (first (mognitio.ir:module-functions module))) (code nil) (homes (make-hash-table)) (block-map (make-hash-table))
        (serial 0) (span (mognitio.ir:module-span module)))
    (labels ((emit (opcode &rest operands)
               (push (make-instruction :opcode opcode :operands operands :span span) code))
             (label-id (id) (list :block id))
             (fresh-label () (list :internal (incf serial)))
             (home (id)
               (multiple-value-bind (offset found) (gethash id homes)
                 (unless found (internal-error "Missing value home")) offset))
             (load-value (id &optional (reg :load-rax)) (emit reg (home id)))
             (arithmetic (inst)
               (let ((op (mognitio.ir:instruction-op inst)))
                 (case op
                   ((:neg :add :sub :mul) (emit op) (emit :jo :overflow))
                   ((:div :rem)
                    (emit :test-rcx) (emit :jz (if (eq op :div) :division-by-zero :remainder-by-zero))
                    (let ((safe (fresh-label)))
                      (emit :cmp-rcx-minus-one) (emit :jnz safe)
                      (emit :imm-rdx mognitio.integer:+minimum+) (emit :cmp-rax-rdx)
                      (emit :jz :overflow) (emit :label safe)
                      (emit :cqo) (emit :idiv))
                    (when (eq op :rem) (emit :mov-rax-rdx)))
                   ((:eq :ne :lt :le :gt :ge) (emit :cmp) (emit :set-bool op))
                   (otherwise (internal-error "Unsupported SSA operation")))))
             (runtime ()
               (dolist (form '((:label :print) (:test) (:jz :false)
                              (:lea-rsi :true-data) (:mov-edx 5) (:jmp :normal-setup)
                              (:label :false) (:lea-rsi :false-data) (:mov-edx 6)
                              (:label :normal-setup) (:mov-edi 1) (:mov-r8d 0) (:mov-r9d 1)
                              (:jmp :write-setup)))
                 (apply #'emit form))
               (dolist (kind '(:overflow :division-by-zero :remainder-by-zero))
                 (emit :label kind)
                 (emit :lea-rsi (list :data kind))
                 (emit :mov-edx (length (mognitio.runtime:failure-octets kind)))
                 (emit :mov-edi 2)
                 (emit :mov-r8d (mognitio.runtime:failure-status kind))
                 (emit :mov-r9d (mognitio.runtime:failure-status kind))
                 (emit :jmp :write-setup))
               (emit :label :write-setup) (emit :mov-r10d mognitio.runtime:+retry-budget+)
               (dolist (form '((:label :write-loop) (:mov-eax 1) (:syscall)
                              (:cmp-eintr) (:jz :write-interrupted)
                              (:test) (:jle :write-error) (:add-rsi) (:sub-rdx)))
                 (apply #'emit form))
               (emit :mov-r10d mognitio.runtime:+retry-budget+)
               (dolist (form '((:jnz :write-loop) (:mov-edi-r8d) (:jmp :exit)
                              (:label :write-interrupted) (:cmp-r9d-one) (:jz :write-loop)
                              (:dec-r10d) (:jnz :write-loop)
                              (:label :write-error) (:mov-edi-r9d)
                              (:label :exit) (:mov-eax 60) (:syscall) (:ud2)
                              (:label :true-data) (:bytes 116 114 117 101 10)
                              (:label :false-data) (:bytes 102 97 108 115 101 10)))
                 (apply #'emit form))
               (dolist (kind '(:overflow :division-by-zero :remainder-by-zero))
                 (emit :label (list :data kind))
                 (apply #'emit :bytes (coerce (mognitio.runtime:failure-octets kind) 'list)))))
      (let ((ids nil))
        (dolist (b (mognitio.ir:ir-function-blocks function))
          (setf (gethash (mognitio.ir:basic-block-id b) block-map) b)
          (dolist (p (mognitio.ir:basic-block-parameters b)) (push (car p) ids))
          (dolist (i (mognitio.ir:basic-block-instructions b))
            (push (mognitio.ir:instruction-result i) ids)))
        (loop for id in (sort ids #'<) for index from 0 do
          (unless (typep (* index 8) '(signed-byte 32)) (internal-error "Frame offset overflow"))
          (setf (gethash id homes) (* index 8))))
      (emit :imm-rcx (hash-table-count homes))
      (emit :test-rcx) (emit :jz (label-id (mognitio.ir:ir-function-entry function)))
      (emit :label :frame-loop) (emit :push-zero) (emit :dec-rcx) (emit :jnz :frame-loop)
      (emit :jmp (label-id (mognitio.ir:ir-function-entry function)))
      (dolist (block (mognitio.ir:ir-function-blocks function))
        (setf span (mognitio.ir:basic-block-span block))
        (emit :label (label-id (mognitio.ir:basic-block-id block)))
        (dolist (inst (mognitio.ir:basic-block-instructions block))
          (setf span (mognitio.ir:instruction-span inst))
          (if (eq (mognitio.ir:instruction-op inst) :constant)
              (emit :imm-rax (mognitio.ir:instruction-value inst))
              (progn
                (load-value (first (mognitio.ir:instruction-operands inst)))
                (when (second (mognitio.ir:instruction-operands inst))
                  (load-value (second (mognitio.ir:instruction-operands inst)) :load-rcx))
                (arithmetic inst)))
          (emit :store-rax (home (mognitio.ir:instruction-result inst))))
        (let ((term (mognitio.ir:basic-block-terminator block)))
          (ecase (first term)
            (:branch (load-value (second term)) (emit :test)
                     (emit :jz (label-id (fourth term))) (emit :jmp (label-id (third term))))
            (:jump
             (let ((params (mognitio.ir:basic-block-parameters (gethash (second term) block-map)))
                   (args (third term)))
               (when (intersection args (mapcar #'car params)) (internal-error "Aliasing edge copy"))
               (loop for p in params for a in args do
                 (load-value a) (emit :store-rax (home (car p)))))
             (emit :jmp (label-id (second term))))
            (:return (load-value (second term)) (emit :jmp :print)))))
      (runtime)
      (nreverse code))))
