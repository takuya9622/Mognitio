(in-package #:mognitio.ir)

(defstruct instruction result (type :bool) op value span)
(defstruct basic-block id parameters instructions terminator span)
(defstruct module blocks entry span)

(defun lower-program (checked)
  (unless (typep checked 'checked-program)
    (internal-error "Native lowering requires a checked program"))
  (let ((blocks nil) (next-block 0) (next-value 0)
        (root (program-root (checked-program-program checked))))
    (labels ((new-value () (prog1 next-value (incf next-value)))
             (new-block (span &optional parameters)
               (let ((block (make-basic-block :id next-block :span span
                                              :parameters parameters)))
                 (incf next-block)
                 (push block blocks)
                 block))
             (lower (node current)
               (etypecase node
                 (boolean-literal
                  (let ((value (new-value)))
                    (push (make-instruction :result value :op :constant
                                            :value (ecase (boolean-literal-value node)
                                                     (:false 0) (:true 1))
                                            :span (node-span node))
                          (basic-block-instructions current))
                    (values value current)))
                 (if-expression
                  (multiple-value-bind (condition condition-end)
                      (lower (if-expression-condition node) current)
                    (let* ((then (new-block (node-span node)))
                           (else (new-block (node-span node)))
                           (result (new-value))
                           (merge (new-block (node-span node) (list result))))
                      (setf (basic-block-terminator condition-end)
                            (list :branch condition (basic-block-id then)
                                  (basic-block-id else)))
                      (multiple-value-bind (value end)
                          (lower (if-expression-then-branch node) then)
                        (setf (basic-block-terminator end)
                              (list :jump (basic-block-id merge) value)))
                      (multiple-value-bind (value end)
                          (lower (if-expression-else-branch node) else)
                        (setf (basic-block-terminator end)
                              (list :jump (basic-block-id merge) value)))
                      (values result merge)))))))
      (let ((entry (new-block (node-span root))))
        (multiple-value-bind (value end) (lower root entry)
          (setf (basic-block-terminator end) (list :return value)))
        (dolist (block blocks)
          (setf (basic-block-instructions block)
                (nreverse (basic-block-instructions block))))
        (make-module :blocks (nreverse blocks) :entry (basic-block-id entry)
                     :span (node-span root))))))

(defun successors (block)
  (let ((term (basic-block-terminator block)))
    (case (first term)
      (:branch (list (third term) (fourth term)))
      (:jump (list (second term)))
      (:return nil)
      (otherwise (internal-error "Invalid SSA terminator")))))

(defun verify-module-internal (module)
  (let ((blocks (make-hash-table)) (definitions (make-hash-table))
        (predecessors (make-hash-table)) (colors (make-hash-table))
        (dominators (make-hash-table)) (order nil))
    (labels ((require-ir (value message) (unless value (internal-error message)))
             (define-value (value block position)
               (require-ir (and (typep value '(integer 0 *))
                                (not (gethash value definitions)))
                           "Invalid or duplicate SSA value")
               (setf (gethash value definitions) (cons block position)))
             (visit (id)
               (case (gethash id colors)
                 (:gray (internal-error "Cyclic SSA control flow"))
                 (:black nil)
                 (otherwise
                  (setf (gethash id colors) :gray)
                  (dolist (next (successors (gethash id blocks))) (visit next))
                  (setf (gethash id colors) :black)
                  (push id order))))
             (check-use (value id position)
               (let ((definition (gethash value definitions)))
                 (require-ir
                  (and definition
                       (if (= id (car definition))
                           (< (cdr definition) position)
                           (member (car definition) (gethash id dominators))))
                  "Undefined or non-dominating SSA value"))))
      (require-ir (and (module-p module) (module-blocks module)) "Invalid SSA module")
      (dolist (block (module-blocks module))
        (let ((id (basic-block-id block)))
          (require-ir (and (typep id '(integer 0 *)) (not (gethash id blocks)))
                      "Invalid or duplicate SSA block")
          (setf (gethash id blocks) block)
          (require-ir (<= (length (basic-block-parameters block)) 1)
                      "Unsupported SSA block parameters")
          (dolist (value (basic-block-parameters block)) (define-value value id -1))
          (loop for instruction in (basic-block-instructions block)
                for position from 0
                do (require-ir (and (eq (instruction-type instruction) :bool)
                                    (eq (instruction-op instruction) :constant)
                                    (member (instruction-value instruction) '(0 1)))
                               "Invalid SSA instruction or type")
                   (define-value (instruction-result instruction) id position))))
      (require-ir (gethash (module-entry module) blocks) "Missing SSA entry")
      (require-ir (null (basic-block-parameters (gethash (module-entry module) blocks)))
                  "SSA entry cannot have parameters")
      (dolist (block (module-blocks module))
        (let ((term (basic-block-terminator block)))
          (require-ir (= (length term)
                         (ecase (first term) (:branch 4) (:jump 3) (:return 2)))
                      "Invalid SSA terminator operands")
          (dolist (next (successors block))
            (let ((target (gethash next blocks)))
              (require-ir target "Missing SSA edge target")
              (require-ir (= (length (basic-block-parameters target))
                             (if (eq (first term) :jump) 1 0))
                          "SSA edge argument count mismatch")
              (push (basic-block-id block) (gethash next predecessors))))))
      (visit (module-entry module))
      (require-ir (= (length order) (hash-table-count blocks)) "Unreachable SSA block")
      (dolist (id order)
        (let* ((preds (gethash id predecessors))
               (common (when preds (copy-list (gethash (first preds) dominators)))))
          (dolist (pred (rest preds))
            (setf common (intersection common (gethash pred dominators))))
          (setf (gethash id dominators) (cons id common)))
        (let* ((block (gethash id blocks)) (term (basic-block-terminator block)))
          (check-use (if (eq (first term) :jump) (third term) (second term))
                     id (length (basic-block-instructions block)))))
      module)))

(defun verify-module (module)
  (handler-case (verify-module-internal module)
    (internal-failure (condition) (error condition))
    (error () (internal-error "Malformed SSA module"))))
